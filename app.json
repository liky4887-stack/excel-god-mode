{
  "expo": {
    "name": "Excel Mode",
    "slug": "excel-mode",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "excelgodmode",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.excelgodmode.app"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
